*.py[cod]
*.pyo

# Configuración local y secretos
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Configuración de editores
.idea/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
